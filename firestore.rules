rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function draftPath(id) { return /databases/$(database)/documents/drafts/$(id); }
    // Aggiunge solo sé stesso alla lista dei membri.
    function joinsSelf() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members;
    }

    match /boards/{boardId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.cells is list && request.resource.data.cells.size() == 25
        && (
          (request.resource.data.createdBy == request.auth.uid
            && request.resource.data.members == [request.auth.uid])
          // Tabellone nato da una creazione condivisa: lo può generare qualsiasi partecipante
          // dopo la scadenza (o il creatore in qualsiasi momento).
          || (exists(draftPath(boardId))
            && get(draftPath(boardId)).data.status == 'open'
            && request.auth.uid in get(draftPath(boardId)).data.members
            && request.resource.data.createdBy == get(draftPath(boardId)).data.createdBy
            && request.resource.data.members == get(draftPath(boardId)).data.members
            && (request.time.toMillis() >= get(draftPath(boardId)).data.deadline
                || get(draftPath(boardId)).data.createdBy == request.auth.uid))
        );
      allow update: if signedIn() && (
        (resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy)
        || joinsSelf()
      );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /players/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /drafts/{draftId} {
      function draftOpen() { return get(draftPath(draftId)).data.status == 'open'; }
      function draftCreator() { return get(draftPath(draftId)).data.createdBy == request.auth.uid; }

      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.status == 'open'
        && request.resource.data.deadline is number;
      allow update: if signedIn() && (
        // Il creatore cambia nome, scadenza o la chiude.
        (resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.members == resource.data.members)
        || joinsSelf()
        // Chiusura alla scadenza da parte di un partecipante.
        || (resource.data.status == 'open'
          && request.auth.uid in resource.data.members
          && request.time.toMillis() >= resource.data.deadline
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'boardId', 'closedAt'])
          && request.resource.data.status == 'closed'
          && request.resource.data.boardId == draftId)
      );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /entries/{entryId} {
        allow read: if signedIn();
        allow create: if signedIn() && draftOpen()
          && request.resource.data.author == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 70;
        allow delete: if signedIn() && (resource.data.author == request.auth.uid || draftCreator());
      }
      // Un documento per persona: nome e voti (pollici su / giù).
      match /people/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid && draftOpen();
      }
    }
  }
}
