rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /boards/{boardId} {
      // Chi ha il link (e ha fatto l'accesso) può aprire il tabellone.
      allow get: if signedIn();
      // La lista "I tuoi tabelloni" mostra solo quelli di cui sei membro.
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.cells is list && request.resource.data.cells.size() == 25;
      // Il creatore modifica tutto; gli altri possono solo aggiungere sé stessi ai membri.
      allow update: if signedIn() && (
        (resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members)
      );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /players/{uid} {
        allow read: if signedIn();
        // Ognuno scrive solo le proprie caselle.
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
